{
  "database": {
    "provider": "Cloudflare D1 via Sites",
    "binding": "DB",
    "tables": [
      "account_challenges",
      "accounts",
      "auth_attempts",
      "clubs",
      "sessions",
      "support_messages"
    ],
    "schemaIncluded": true,
    "actualRowsExported": false,
    "reason": "No provider-level full snapshot/export tool available; authentication/session secrets and private user data must not enter source repositories."
  },
  "objectStorage": {
    "provider": "Sites Cloudflare R2",
    "binding": "BUCKET",
    "objectListingOrSnapshotAvailable": false,
    "actualBucketSnapshotExported": false,
    "knownCurrentApkPreserved": true
  },
  "runtimeSecrets": {
    "valuesExported": false,
    "requiredNames": [
      "AUTH_PEPPER"
    ],
    "optionalMailNames": [
      "RESEND_API_KEY",
      "MAIL_FROM"
    ],
    "restoreFromOwnerSecureSecretStore": true
  },
  "androidDeviceLocalData": {
    "exported": false,
    "note": "Device localStorage/manual recordings and session vault are not accessible from this workspace."
  },
  "signing": {
    "existingKeystorePresent": true,
    "path": "/workspace/android-tools/user/debug.keystore",
    "copiedOrUploaded": false,
    "certificateSha256": "968e6554f40e6cdc7e134c731c3ec42402c3fb9181f3e015b614da7d81d0204b"
  }
}
