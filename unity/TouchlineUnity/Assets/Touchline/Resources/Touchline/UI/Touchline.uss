:root { --navy: rgb(12, 27, 39); --surface: rgb(24, 47, 62); --lime: rgb(190, 245, 103); --ink: rgb(240, 247, 235); --muted: rgb(190, 206, 211); }
.club-screen { flex-grow: 1; background-color: var(--navy); padding: 20px; color: var(--ink); }
.club-scroll { flex-grow: 1; }
.header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.brand { font-size: 34px; -unity-font-style: bold; color: var(--lime); }
.eyebrow { font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.balance { font-size: 18px; color: var(--lime); white-space: nowrap; }
.title { font-size: 29px; -unity-font-style: bold; color: var(--ink); margin-bottom: 8px; white-space: normal; }
.subtitle { font-size: 18px; color: var(--muted); margin-bottom: 18px; white-space: normal; }
.heading { font-size: 21px; -unity-font-style: bold; color: var(--ink); margin-bottom: 10px; margin-top: 12px; white-space: normal; }
.body { font-size: 16px; color: var(--ink); white-space: normal; margin-bottom: 12px; }
.hint { font-size: 14px; color: var(--muted); white-space: normal; margin-top: 6px; margin-bottom: 14px; }
.notice { font-size: 16px; color: var(--lime); white-space: normal; margin-bottom: 14px; }
.row { flex-direction: row; align-items: center; }
.wrap-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.metric { font-size: 15px; color: var(--ink); margin-right: 20px; margin-bottom: 12px; }
.card { padding: 18px; margin-bottom: 18px; background-color: var(--surface); border-radius: 14px; }
button { min-height: 44px; padding: 8px 14px; margin: 0 8px 8px 0; border-width: 1px; border-color: rgb(77, 102, 117); border-radius: 9px; color: var(--ink); background-color: rgb(31, 57, 73); font-size: 15px; white-space: nowrap; }
button:hover { background-color: rgb(43, 75, 92); }
button:focus { border-color: var(--lime); border-width: 2px; }
button:active, .selected { background-color: rgb(56, 82, 53); border-color: var(--lime); }
button:disabled { opacity: 0.5; }
.primary { background-color: var(--lime); color: rgb(15, 34, 28); -unity-font-style: bold; min-height: 50px; }
.primary:hover { background-color: rgb(207, 255, 131); }
.player-row { flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgb(47, 72, 87); }
.player-name { font-size: 16px; color: var(--ink); white-space: normal; }
.player-row > VisualElement { flex-shrink: 1; margin-right: 10px; }
Toggle { color: var(--ink); font-size: 16px; min-height: 40px; margin-bottom: 8px; }
.portrait .header { align-items: flex-start; }
.portrait .metric { margin-right: 12px; font-size: 13px; }
.portrait .player-row { flex-wrap: wrap; }
.portrait .player-row button { margin-top: 4px; }
.match-screen { flex-grow: 1; color: var(--ink); }
.match-top { flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 12px; }
.score-card { padding: 10px 15px; background-color: rgb(13, 35, 49); border-left-width: 4px; border-left-color: var(--lime); border-radius: 8px; }
.score { font-size: 24px; -unity-font-style: bold; color: var(--ink); }
.clock { font-size: 12px; color: var(--lime); }
.match-top button { min-height: 40px; font-size: 12px; padding: 5px 9px; margin-right: 5px; }
.live { position: absolute; top: 90px; left: 12px; max-width: 330px; padding: 10px 12px; background-color: rgba(12, 31, 45, 0.94); color: var(--ink); font-size: 13px; white-space: normal; border-radius: 8px; }
.focus-player { position: absolute; bottom: 16px; left: 32%; right: 31%; color: var(--ink); background-color: rgba(12, 31, 45, 0.94); border-bottom-width: 3px; border-bottom-color: var(--lime); padding: 8px; font-size: 12px; white-space: normal; -unity-text-align: middle-center; }
.charge { position: absolute; bottom: 63px; left: 35%; right: 35%; font-size: 14px; color: var(--lime); -unity-text-align: middle-center; }
.controls { position: absolute; bottom: 16px; left: 16px; right: 16px; flex-direction: row; justify-content: space-between; align-items: flex-end; }
.joystick { width: 120px; height: 120px; border-radius: 60px; background-color: rgba(10, 29, 34, 0.55); border-width: 2px; border-color: rgba(218, 244, 193, 0.7); }
.thumb { position: absolute; width: 42px; height: 42px; left: 37px; top: 37px; border-radius: 21px; background-color: rgba(226, 246, 219, 0.9); }
.actions { width: 248px; flex-direction: row; flex-wrap: wrap; justify-content: flex-end; }
.action { width: 70px; height: 62px; margin: 4px; border-radius: 20px; border-width: 2px; border-color: var(--lime); background-color: rgba(12, 31, 40, 0.86); justify-content: center; align-items: center; }
.action-label { font-size: 10px; -unity-font-style: bold; color: var(--ink); white-space: normal; -unity-text-align: middle-center; }
.action:hover { background-color: rgb(42, 67, 62); }
.action.down, .joystick.down { background-color: rgba(112, 154, 61, 0.8); border-color: rgb(230, 255, 195); }
.portrait .match-top { flex-direction: column; }
.portrait .live { top: 140px; }
.portrait .actions { width: 164px; }
.portrait .focus-player { left: 24%; right: 8%; bottom: 240px; }
.portrait .charge { bottom: 285px; }
.result { position: absolute; top: 22%; left: 22%; right: 22%; background-color: rgb(15, 37, 52); padding: 24px; border-radius: 16px; border-width: 1px; border-color: rgb(84, 115, 128); align-items: center; }
.portrait .result { left: 6%; right: 6%; }
.splash { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgb(12, 27, 39); justify-content: center; align-items: center; }
