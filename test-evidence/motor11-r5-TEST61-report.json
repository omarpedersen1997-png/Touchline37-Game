{
  "schemaVersion": 1,
  "update": {
    "id": "TEST61",
    "title": "Lettere Auto 3D og Motor 11 R5",
    "date": "2026-11-23",
    "sourceCommit": "ef7a944ec833f0f361d1a9eaaacbcf194e8fafda",
    "summary": "TEST61 kombinerer en lettere 3D-rendersti, en ny lokal kamprevision og kampgrafik i det nye Touchline-webdesign. Dynamisk aflastning gør færre tunge figurer synlige ad gangen. R5 simulerer på faste 50 ms-trin, og den viste bold og spillerposition interpoleres mellem dem."
  },
  "apk": {
    "appId": "dk.touchline.footballidle.test",
    "versionCode": 61,
    "versionName": "1.0.0-test-match61",
    "fileName": "Touchline37-Motor11-TEST61.apk",
    "bytes": 47245197,
    "sha256": "20678269872c47237a21ab5379033f0fd478799de4c5ac010c742475ea9f2c84",
    "downloadUrl": "https://github.com/omarpedersen1997-png/Touchline37-Game/blob/codex/test61-match-performance-design/dev/artifacts/Touchline37-Motor11-TEST61.apk"
  },
  "changes": [
    {
      "title": "Auto 3D med væsentligt mindre 3D-arbejde",
      "detail": "Animerede spillere langt fra bolden deler ét instansieret renderkald. Den aktive spiller og nære aktioner bruger stadig de detaljerede modeller. Medianen i browserens målevindue var 220 → 66 renderkald og 421.272 → 273.664 trekanter pr. indsendt billede."
    },
    {
      "title": "Billigere lys, baggrund og grafiktilpasning",
      "detail": "Auto benytter diffuse teksturer og lettere lyssætning, mindre publikumstæthed og samlede reklamebander. Kamera, bold og spillerpositioner følger den visuelle billedrate, mens fjerne skeletstillinger genbruges. Indstillinger og stående orientering standser tegning i testkampen. Skarp 3D og 4K har stadig de detaljerede figurer og materialer."
    },
    {
      "title": "R5-bold, hovedstød og duelrespons",
      "detail": "Vådt græs giver længere glid og lavere opspring. Modtagerens kropsvinkel, fart, pres og banen påvirker førsteberøringen. Skulderkontakt overfører bevægelse kun ved kontakt under indløb. Høje bolde kan heades væk eller mod mål. Afleveringsplanen beregner rulletid uden at køre hele boldsimuleringen for hver mulig pasning."
    },
    {
      "title": "Taktik, målmand og dommerforløb",
      "detail": "Højt pres flytter kæden frem og forlænger genpresset. Målmanden forsøger at komme ud til høje indlæg inden for rækkevidde og sætter tidligere i gang under pres. Hjemmeholdet kan vælge kort frispark eller skud. Hver halvleg har to faste simulerede tillægsminutter."
    },
    {
      "title": "Matchende kampdesign og kamera",
      "detail": "Kampindgangen genbruger illustration og sports­typografi fra Touchlines nye offentlige website. Scoreboard og kampmenu bruger den samme lime, elfenben og dybe grønne palet. Kameravinklerne er Broadcast, Taktisk og Mål / nær. TV-grafikken viser xG, billedrate, frametime og advarsel ved lav billedrate."
    }
  ],
  "tests": {
    "passed": 838,
    "phoneModel": "OnePlus Nord 4",
    "physicalDeviceVerified": false,
    "note": "838 automatiske tests bestået, inklusive 11 nye. TEST61 nåede slutfløjt i Chromium, hvor én simuleret kamp tager omkring 4 min. 21 sek. Chromium brugte software-WebGL. Mobilens GPU, 60–120 FPS og fysisk touch er endnu åbne målinger.",
    "checks": [
      "R5 giver identisk slutstate og inputpakke ved 60- og 120 Hz renderkadence. Fem fulde R4-kampe fra TEST60 gav uændret slutstate og samme inputbytes i TEST61.",
      "Tests dækker våd og tør bane, planlægning af pasninger, hovedstød, kropskontakt, målmandsudløb, frisparksvalg, tillægstid, kamera og instansierede spillere.",
      "Endelig 3D-kamp med pakkede webfiler til slutfløjt. Tidligere kandidat gennemførte også 2D. Ingen konsolfejl, serverwrites eller ændringer i seedede lokale valg.",
      "Kampindgangen er prøvet i 320 × 640, 390 × 844, 915 × 412 og 1280 × 720. Kamera, Højt pres, portrætadvarsel og oprydning efter lukning er dækket.",
      "APK’en er kontrolleret med CRC, SHA-256 og testcertifikatet fra TEST60. Alle pakkede webfiler matcher staging byte for byte."
    ]
  },
