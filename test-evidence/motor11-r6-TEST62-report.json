  "update": {
    "id": "TEST62",
    "title": "Leddelte spillere og Motor 11 R6",
    "date": "2026-11-23",
    "sourceCommit": "440eb131e5cf01a1d8b3c093e377488d1a6d67a9",
    "summary": "De lette figurer har nu et skelet med hofte, knæ, hænder og separate støvler. Nye R6-regler knytter spark og stolpetræf tættere sammen med kropsretning og boldens bevægelse. R6 kan prøves direkte uden konto i den separate testapp."
  },
  "apk": {
    "appId": "dk.touchline.footballidle.test",
    "versionCode": 62,
    "versionName": "1.0.0-test-match62",
